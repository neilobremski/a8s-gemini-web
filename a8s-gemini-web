#!/usr/bin/env bash
set -euo pipefail

# A symlink onto PATH must resolve to the repo, not to the symlink's own
# directory. readlink without -f, in a loop: it is the form that behaves the
# same everywhere this runs.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  DIR="$(cd "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  case "$SELF" in /*) ;; *) SELF="$DIR/$SELF" ;; esac
done
SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd)"
exec python3 "$SCRIPT_DIR/src/__main__.py" "$@"
